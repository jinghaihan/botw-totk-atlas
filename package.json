{
  "name": "wilds-atlas",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "description": "A local-first exploration and collection tracker for Breath of the Wild and Tears of the Kingdom.",
  "author": "jinghaihan",
  "license": "MIT",
  "homepage": "https://github.com/jinghaihan/wilds-atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinghaihan/wilds-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/jinghaihan/wilds-atlas/issues"
  },
  "keywords": [
    "zelda",
    "botw",
    "totk",
    "interactive-map",
    "save-viewer",
    "vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deps": "taze major -I",
    "lint": "eslint",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "release": "bumpp",
    "bootstrap": "pnpm install",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@unhead/vue": "catalog:frontend",
    "@unocss/reset": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "dexie": "catalog:frontend",
    "reka-ui": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "zod": "catalog:frontend",
    "leaflet": "catalog:map",
    "leaflet.markercluster": "catalog:map",
    "crc-32": "catalog:utils",
    "murmurhash3js": "catalog:utils"
  },
  "devDependencies": {
    "@octohash/vite-config": "catalog:build",
    "vite": "catalog:build",
    "bumpp": "catalog:dev",
    "opencc-js": "catalog:dev",
    "pncat": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "@unocss/preset-web-fonts": "catalog:frontend",
    "unocss": "catalog:frontend",
    "@iconify-json/lucide": "catalog:icons",
    "@octohash/eslint-config": "catalog:lint",
    "@unocss/eslint-config": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "lint-staged": "catalog:lint",
    "vue-tsc": "catalog:lint",
    "fake-indexeddb": "catalog:test",
    "vitest": "catalog:test",
    "@types/leaflet": "catalog:types",
    "@types/leaflet.markercluster": "catalog:types",
    "@types/murmurhash3js": "catalog:types",
    "@types/node": "catalog:types"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
